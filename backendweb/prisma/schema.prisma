// PostgreSQL + Prisma — платформа заказа услуг переводчиков

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  TRANSLATOR
  ADMIN
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING_TRANSLATOR
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OrderUrgency {
  STANDARD
  EXPRESS
}

enum FileKind {
  SOURCE
  DELIVERY
  REFERENCE
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  HELD
  RELEASED
  REFUNDED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CLIENT)
  fullName     String
  phone        String?
  locale       String    @default("ru")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  translatorProfile   TranslatorProfile?
  clientOrders        Order[]              @relation("ClientOrders")
  translatorOrders    Order[]              @relation("TranslatorOrders")
  messagesSent        Message[]            @relation("MessageSender")
  reviewsWritten      Review[]             @relation("ReviewAuthor")
  orderBids           OrderBid[]
  complaintsAuthored  Complaint[]          @relation("ComplaintAuthor")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Справочник типов перевода (админ)
model DictionaryTranslationType {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  priceMultiplier  Decimal  @default(1.00) @db.Decimal(8, 4)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Справочник языковых пар (админ)
model DictionaryLanguagePair {
  id               String   @id @default(cuid())
  sourceLanguage   String
  targetLanguage   String
  label            String?
  rarityMultiplier Decimal  @default(1.00) @db.Decimal(8, 4)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceLanguage, targetLanguage])
}

model TranslatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String?
  yearsExperience Int      @default(0)
  ratePer1000     Decimal  @db.Decimal(10, 2)
  currency        String   @default("BYN")
  isVerified      Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  languages       TranslatorLanguage[]
  specialties     TranslatorSpecialty[]
  portfolioItems  TranslatorPortfolioItem[]
}

model TranslatorPortfolioItem {
  id                  String            @id @default(cuid())
  translatorProfileId String
  profile             TranslatorProfile @relation(fields: [translatorProfileId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  sampleUrl           String?

  @@index([translatorProfileId])
}

model TranslatorLanguage {
  id                  String            @id @default(cuid())
  translatorProfileId String
  profile             TranslatorProfile @relation(fields: [translatorProfileId], references: [id], onDelete: Cascade)
  languageCode        String
  proficiency         String
  isNative            Boolean           @default(false)

  @@unique([translatorProfileId, languageCode])
  @@index([languageCode])
}

model TranslatorSpecialty {
  id                  String            @id @default(cuid())
  translatorProfileId String
  profile             TranslatorProfile @relation(fields: [translatorProfileId], references: [id], onDelete: Cascade)
  code                String

  @@unique([translatorProfileId, code])
}

model Order {
  id                   String       @id @default(cuid())
  clientId             String
  client               User         @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Restrict)
  translatorId         String?
  translator           User?        @relation("TranslatorOrders", fields: [translatorId], references: [id], onDelete: SetNull)

  title                String
  description          String
  sourceLanguage       String
  targetLanguage       String
  translationTypeCode  String?
  urgency              OrderUrgency @default(STANDARD)
  status               OrderStatus  @default(DRAFT)
  wordCount            Int?
  estimatedPrice       Decimal?     @db.Decimal(12, 2)
  agreedPrice          Decimal?     @db.Decimal(12, 2)
  currency             String       @default("BYN")
  deadlineAt           DateTime?
  submittedAt          DateTime?
  acceptedAt           DateTime?
  deliveredAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  files       OrderFile[]
  messages    Message[]
  review      Review?
  bids        OrderBid[]
  payment     Payment?
  complaints  Complaint[]

  @@index([clientId])
  @@index([translatorId])
  @@index([status])
  @@index([sourceLanguage, targetLanguage])
}

model OrderBid {
  id                   String    @id @default(cuid())
  orderId              String
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  translatorId         String
  translator           User      @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  proposedPrice        Decimal   @db.Decimal(12, 2)
  proposedDeadlineAt DateTime
  comment              String?
  status               BidStatus @default(PENDING)
  createdAt            DateTime  @default(now())

  @@index([orderId])
  @@index([translatorId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(HELD)
  heldAt     DateTime?
  releasedAt DateTime?
  createdAt  DateTime      @default(now())
}

model Complaint {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String
  author     User             @relation("ComplaintAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  status     ComplaintStatus  @default(OPEN)
  adminNotes String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([orderId])
  @@index([status])
}

model OrderFile {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       FileKind
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedAt DateTime @default(now())

  @@index([orderId])
}

model Message {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([orderId])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([authorId])
}
